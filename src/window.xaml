<!-- LocalTokens window. Colours are the brushes in Window.Resources; a theme (lib\theme.ps1) replaces them. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalTokens" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="False"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg"     Color="#FF15171C"/>
    <SolidColorBrush x:Key="Border" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Line"   Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Track"  Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="TextHi" Color="#FFF4F4F5"/>
    <SolidColorBrush x:Key="Text2"  Color="#FFD4D4D8"/>
    <SolidColorBrush x:Key="Muted"  Color="#FF8B8B94"/>
    <SolidColorBrush x:Key="Dim"    Color="#FF71717A"/>
    <SolidColorBrush x:Key="Accent" Color="#FF2DD4BF"/>
    <Style x:Key="Btn" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource TextHi}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Border x:Name="Root" CornerRadius="10" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}"
          BorderThickness="1" Padding="12,10,12,11">
    <Border.Effect>
      <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.55" Color="Black"/>
    </Border.Effect>
    <Grid>
    <!-- the theme's pattern, under everything, out to the window's edge -->
    <Rectangle x:Name="Pattern" Margin="-12,-10,-12,-11" RadiusX="10" RadiusY="10" IsHitTestVisible="False"/>
    <StackPanel Width="238">

      <!-- header -->
      <Grid Margin="0,0,0,6">
        <TextBlock Text="LOCALTOKENS" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock x:Name="BtnMenu" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                     Style="{StaticResource Btn}" Margin="0,0,10,0" ToolTip="Settings"/>
          <TextBlock x:Name="BtnDetails" Text="&#x25BE;" FontSize="11" Style="{StaticResource Btn}"
                     Margin="0,0,9,0" ToolTip="Details"/>
          <TextBlock x:Name="BtnHide" Text="&#x2013;" FontSize="13" Style="{StaticResource Btn}"
                     Margin="0,0,9,0" ToolTip="Hide to tray"/>
          <TextBlock x:Name="BtnExit" Text="&#x2715;" FontSize="11" Style="{StaticResource Btn}" ToolTip="Exit"/>
        </StackPanel>
      </Grid>

      <!-- status: what the active server is doing -->
      <Grid Margin="0,0,0,1">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="Dot" Width="7" Height="7" Fill="#FF6B7280" VerticalAlignment="Center" Margin="0,1,6,0"/>
          <TextBlock x:Name="Status" Text="starting..." FontFamily="Segoe UI" FontSize="10.5" Foreground="{DynamicResource Text2}"/>
        </StackPanel>
        <TextBlock x:Name="SourceTag" Text="" FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Background="Transparent"/>
      </Grid>

      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="Big" Text="--" FontFamily="Segoe UI" FontSize="30" FontWeight="Light" Foreground="{DynamicResource TextHi}"/>
        <TextBlock x:Name="BigUnit" Text="tokens this session" FontFamily="Segoe UI" FontSize="11"
                   Foreground="{DynamicResource Muted}" Margin="5,0,0,8" VerticalAlignment="Bottom"/>
      </StackPanel>
      <TextBlock x:Name="ModelLine" Text="" FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource Text2}"
                 TextTrimming="CharacterEllipsis" Margin="0,0,0,9" Background="Transparent"/>

      <Grid Margin="0,0,0,4">
        <TextBlock Text="GEN SPEED" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Dim}"/>
        <TextBlock x:Name="GenLine" Text="" FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
      </Grid>
      <Border Background="{DynamicResource Track}" CornerRadius="2" Height="4" Margin="0,0,0,7">
        <Border x:Name="GenBar" HorizontalAlignment="Left" CornerRadius="2" Background="#FF2DD4BF" Width="0"/>
      </Border>

      <Grid Margin="0,0,0,4" Background="Transparent" ToolTip="Context of the last request against the loaded context size">
        <TextBlock Text="CONTEXT" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Dim}"/>
        <TextBlock x:Name="CtxLine" Text="" FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
      </Grid>
      <Border Background="{DynamicResource Track}" CornerRadius="2" Height="4">
        <Border x:Name="CtxBar" HorizontalAlignment="Left" CornerRadius="2" Background="#FF4ADE80" Width="0"/>
      </Border>

      <Grid Margin="0,10,0,0">
        <TextBlock x:Name="Foot" Text="" FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource Muted}"/>
        <TextBlock x:Name="FootRight" Text="" FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
      </Grid>

      <!-- details -->
      <StackPanel x:Name="Details" Visibility="Collapsed" Margin="0,11,0,0">
        <Border Background="{DynamicResource Line}" Height="1" Margin="0,0,0,8"/>
        <TextBlock Text="LAST 24 HOURS" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Dim}" Margin="0,0,0,4"/>
        <Canvas x:Name="Hourly" Height="42" Background="Transparent"/>
        <Grid Margin="0,1,0,10">
          <TextBlock x:Name="HourStart" Text="" FontFamily="Segoe UI" FontSize="9" Foreground="{DynamicResource Dim}"/>
          <TextBlock Text="now" FontFamily="Segoe UI" FontSize="9" Foreground="{DynamicResource Dim}" HorizontalAlignment="Right"/>
        </Grid>

        <Border Background="{DynamicResource Line}" Height="1" Margin="0,0,0,8"/>
        <TextBlock Text="TOTALS" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Dim}" Margin="0,0,0,4"/>
        <StackPanel x:Name="Totals" Margin="0,0,0,10"/>

        <Border Background="{DynamicResource Line}" Height="1" Margin="0,0,0,8"/>
        <TextBlock Text="MODELS TODAY" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Dim}" Margin="0,0,0,4"/>
        <StackPanel x:Name="Models" Margin="0,0,0,10"/>

        <Border Background="{DynamicResource Line}" Height="1" Margin="0,0,0,8"/>
        <TextBlock x:Name="LastLbl" Text="LAST REQUEST" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Dim}" Margin="0,0,0,4" Background="Transparent"/>
        <StackPanel x:Name="LastReq" Margin="0,0,0,10"/>

        <Border Background="{DynamicResource Line}" Height="1" Margin="0,0,0,8"/>
        <TextBlock Text="LOADED" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Dim}" Margin="0,0,0,4"/>
        <StackPanel x:Name="LoadedList" Margin="0,0,0,10"/>

        <Border Background="{DynamicResource Line}" Height="1" Margin="0,0,0,8"/>
        <TextBlock Text="LOG FOLDERS" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Dim}" Margin="0,0,0,4"/>
        <StackPanel x:Name="SourceList"/>
      </StackPanel>

      <Grid Margin="0,9,0,0">
        <TextBlock x:Name="ErrLine" Text="" FontFamily="Segoe UI" FontSize="9.5" Foreground="#FFF87171"
                   TextWrapping="Wrap" Margin="0,0,60,0"/>
        <TextBlock x:Name="Stamp" Text="" FontFamily="Segoe UI" FontSize="9" Foreground="{DynamicResource Dim}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
      </Grid>
    </StackPanel>
    </Grid>
  </Border>
</Window>
